# --- Supabase project (Auth / client SDK) ---
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Service role (secret) — required for Nest to upload into a private Storage bucket
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# --- PostgreSQL for Prisma ---
# Local / migrate: Direct connection (often IPv6-only on new Supabase projects)
# Railway / cloud: use Session or Transaction **pooler** (IPv4) or app cannot reach db.*:5432 (P1001)
# Dashboard → Database → Connect → Connection pooling
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"

# Auth: test = allow Bearer test:<userId> + JWT; supabase = JWT only
AUTH_MODE="test"
DEFAULT_SIGNUP_ROLE="SALES"
# PASSWORD_RESET_REDIRECT_URL="http://localhost:3001/reset-password"

# Google OAuth (Nest BFF → Supabase). Enable Google provider in Supabase Dashboard first.
# Supabase → Authentication → URL Configuration → Redirect URLs must contain
# <API_PUBLIC_URL>/api/v1/auth/oauth/callback for every environment.
# Redirect allow-list (comma-separated prefixes). FE redirectTo must start with one of these.
OAUTH_REDIRECT_ALLOW_PREFIX="http://localhost:3001"
OAUTH_SUCCESS_REDIRECT_URL="http://localhost:3001/auth/callback"
# Absolute API origin used to build the Nest OAuth callback (defaults to request host)
API_PUBLIC_URL="http://localhost:3000"
# Production example:
# OAUTH_REDIRECT_ALLOW_PREFIX="https://crm-dny-ui-sepia.vercel.app"
# OAUTH_SUCCESS_REDIRECT_URL="https://crm-dny-ui-sepia.vercel.app/auth/callback"
# API_PUBLIC_URL="https://apidyn.otcayxe.com"

# Storage (Supabase) — STORAGE_BUCKET must match Dashboard bucket name exactly
STORAGE_BUCKET="DNY_BUCKET"
STORAGE_MAX_BYTES="20971520"
STORAGE_SIGNED_URL_TTL="3600"

PORT=3000
