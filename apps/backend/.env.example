# --- Supabase project (Auth / client SDK) ---
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Service role (secret) — required for Nest to upload into a private Storage bucket
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# --- PostgreSQL for Prisma ---
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Auth: test = allow Bearer test:<userId> + JWT; supabase = JWT only
AUTH_MODE="test"
DEFAULT_SIGNUP_ROLE="SALES"
# PASSWORD_RESET_REDIRECT_URL="http://localhost:3001/reset-password"

# Storage (Supabase) — STORAGE_BUCKET must match Dashboard bucket name exactly
STORAGE_BUCKET="DNY_BUCKET"
STORAGE_MAX_BYTES="20971520"
STORAGE_SIGNED_URL_TTL="3600"

PORT=3000
